PORT=3001
HOST=127.0.0.1
MAASAR_ENV=development
AUTH_MODE=dev
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# Required only when AUTH_MODE=cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
