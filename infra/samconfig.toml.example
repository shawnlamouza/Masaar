version = 0.1

[staging.deploy.parameters]
stack_name = "masaar-staging"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
region = "REPLACE_WITH_APPROVED_AWS_REGION"
parameter_overrides = "Environment=staging WebOrigin=https://REPLACE.example BudgetEmail=REPLACE@example.com MonthlyBudgetUsd=35 SqlServerConnectionString=REPLACE_AT_DEPLOYMENT"

[production.deploy.parameters]
stack_name = "masaar-production"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
region = "REPLACE_WITH_APPROVED_AWS_REGION"
parameter_overrides = "Environment=production WebOrigin=https://REPLACE.example BudgetEmail=REPLACE@example.com MonthlyBudgetUsd=75 SqlServerConnectionString=REPLACE_AT_DEPLOYMENT"
