# Shared local defaults. Copy app-specific examples into .env files.
MAASAR_ENV=development
AUTH_MODE=dev
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
# Keep blank for local in-memory development. For a local SQL-authenticated instance, for example:
# Server=localhost;Database=Masaar;User Id=masaar_app;Password=replace-me;Encrypt=false;TrustServerCertificate=true
# Staging/production inject an Amazon RDS for SQL Server connection string from Secrets Manager.
SQLSERVER_CONNECTION_STRING=
